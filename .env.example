# Copy to .env and fill in. Every value here is validated at boot by
# src/config/env.ts — a missing one stops the process immediately.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/placementportal?schema=public"

NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Where the SPA lives. OAuth callbacks redirect back here, and this is the ONLY
# origin they will redirect to — a returnTo pointing anywhere else is ignored.
FRONTEND_URL="http://localhost:5173"

# Public base URL of this API. Must byte-for-byte match the redirect URI
# registered with LinkedIn and Microsoft, or they reject the callback.
API_PUBLIC_URL="http://localhost:4000"

# Must be at least 16 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---------------------------------------------------------------------------
# OAuth — optional. A provider with no client id is simply switched off:
# GET /api/v1/auth/oauth/providers reports configured:false and the SPA can
# hide the button. The server still boots.
# ---------------------------------------------------------------------------

# LinkedIn — https://www.linkedin.com/developers/apps
#   Create an app, request the "Sign In with LinkedIn using OpenID Connect"
#   product, then add this exact redirect URL:
#     http://localhost:4000/api/v1/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Microsoft / Outlook — https://entra.microsoft.com → App registrations
#   Supported account types: "Accounts in any organizational directory and
#   personal Microsoft accounts". Add a Web redirect URI:
#     http://localhost:4000/api/v1/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" = any Microsoft account (work, school or personal).
# Replace with the university's tenant id to restrict sign-in to GU accounts.
MICROSOFT_TENANT="common"
